# Shell scripts and configs run inside Linux containers: always LF line endings,
# even when the repo is checked out on Windows.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.xml text eol=lf
*.hql text eol=lf
*.cql text eol=lf
*.js text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
*.png binary
*.woff2 binary
*.ps1 text eol=crlf
*.cmd text eol=crlf
